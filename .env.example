# Konductor Environment Configuration
# CI runs on this file directly - this is operational, not documentation
# Local overrides: create .env (gitignored) or export in shell

# =============================================================================
# Container Registry
# =============================================================================
# Default: local Zot registry in docker-dev cluster
# Override: CONTAINER_REGISTRY=docker.io or CONTAINER_REGISTRY=ghcr.io
CONTAINER_REGISTRY=registry.docker.arpa
CONTAINER_IMAGE=containercraft/konductor
CONTAINER_TAG=latest-qcow2

# Zot registry credentials
REGISTRY_USERNAME=admin
REGISTRY_PASSWORD=admin

# Kubernetes context for registry CA fetch
KUBECONFIG=../.config/talos/docker-dev/generated/kubeconfig
REGISTRY_K8S_CONTEXT=admin@docker-dev

# =============================================================================
# Docker Hub (CONTAINER_REGISTRY=docker.io)
# =============================================================================
DOCKER_USERNAME=containercraft
DOCKER_TOKEN=

# =============================================================================
# GitHub (CONTAINER_REGISTRY=ghcr.io, GitHub MCP, gh CLI)
# =============================================================================
GITHUB_ACTOR=
GITHUB_TOKEN=

# =============================================================================
# Gitea/Forgejo (Gitea MCP, tea/forgejo-cli)
# =============================================================================
GITEA_URL=https://git.braincraft.io
GITEA_TOKEN=${GITEA_TOKEN:-}

# =============================================================================
# Claude Code Preferences
# =============================================================================
DISABLE_TELEMETRY=0
DISABLE_ERROR_REPORTING=0
DISABLE_COST_WARNINGS=0

# =============================================================================
# QCOW2 Build Configuration
# =============================================================================

# Build file for runme tasks (relative to k9 root per BUILD.md cwd)
QCOW2_BUILD_FILE=docs/developer_guide/qcow2/BUILD.md

# Preflight check lists
QCOW2_REQUIRED_BINS="nix qemu-img qemu-system-x86_64 genisoimage guestmount guestunmount virt-sparsify ssh rsync timeout ss du sha256sum jq docker skopeo"
QCOW2_REQUIRED_FILE_VARS="OVMF_CODE OVMF_VARS"
QCOW2_REQUIRED_VARS="QCOW2_BUILD_FILE"

# Minimum resource requirements
QCOW2_MIN_DISK_GB=100
QCOW2_MIN_MEM_MB=8192
QCOW2_MIN_CPUS=4

# libguestfs backend (direct = no libvirt dependency)
LIBGUESTFS_BACKEND=direct

# Temporary paths
QCOW2_MOUNT=/tmp/nixmount
QCOW2_CLOUD_INIT_DIR=/tmp/konductor-build-cloud-init
QCOW2_PIDFILE=/tmp/konductor-build-vm.pid
QCOW2_SSH_KEY_DIR=${HOME}/.ssh
QCOW2_LOGFILE=build-vm.log

# VM resources (conservative for nested virtualization)
QCOW2_VM_MEMORY=4096
QCOW2_VM_CPUS=4
QCOW2_SSH_PORT=2222
QCOW2_SSH_TIMEOUT=300

# =============================================================================
# Build Skip Flags (for development iteration)
# =============================================================================
# Set to true to skip phases when iterating on specific parts of the build
SKIP_NIX_BUILD=false
SKIP_VM_PHASE=false
SKIP_COMPRESS=false

# =============================================================================
# Provenance Enforcement
# =============================================================================
# STRICT=true: Require /.konductor on build host (fail if missing)
# STRICT=false: Allow building on hosts without provenance (bootstrap mode)
KONDUCTOR_STRICT=false

# =============================================================================
# Promotion Configuration (local registry → public registry)
# =============================================================================
# Source: local Zot registry (CONTAINER_REGISTRY above)
# Target: public registry for promotion
PROMOTE_REGISTRY=docker.io
PROMOTE_IMAGE=containercraft/konductor
PROMOTE_TAG=latest-qcow2
