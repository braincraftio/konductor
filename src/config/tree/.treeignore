# .treeignore - patterns to hide from tree output for visibility
# Used via: eza -I flag (additive to --git-ignore)
#
# The Nix wrapper (default.nix) processes these patterns:
#   - Strips trailing slashes
#   - Prepends **/ to patterns not already starting with *
#   - Joins with | for eza -I flag
#
# Write bare names here. The wrapper handles globbing.

# Lock files (tracked but verbose/noisy)
package-lock.json
pnpm-lock.yaml
yarn.lock
Cargo.lock
go.sum
uv.lock
poetry.lock
Pipfile.lock
composer.lock
Gemfile.lock
flake.lock

# IDE/Editor
.idea
.vscode
.fleet
*.swp
*.swo
*~

# AI assistants
.claude
.gemini
.cursor
.copilot
.aider*

# Nix build artifacts
.direnv
result
result-*

# Node/JS ecosystem
node_modules
.slidev
.nuxt
.next
.output
.parcel-cache

# Build output
dist

# Dev tool caches
.mypy_cache
.pytest_cache
.ruff_cache
__pycache__
.cache
.turbo

# Cloned source material (study repos, not project code)
sources
