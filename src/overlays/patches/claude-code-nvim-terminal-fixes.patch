Three upstream bug fixes for greggh/claude-code.nvim (pinned at 55c0cb5):

1. E444 "Cannot close last window" — handle_existing_instance calls
   nvim_win_close without pcall. When the claude split is the only
   window, toggle crashes. (unfiled upstream)

2. TermClose "Invalid buffer id" — TermClose callback calls
   nvim_buf_get_name on a buffer that may already be invalid.
   (issue #124, PR #132 open unreviewed)

3. Duplicate terminal buffer in split mode — split path uses :terminal
   on the inherited buffer instead of creating a dedicated buffer via
   nvim_create_buf + termopen like the float path does.
   (issue #121, no PR)

--- a/lua/claude-code/file_refresh.lua
+++ b/lua/claude-code/file_refresh.lua
@@ -101,6 +101,7 @@
     group = augroup,
     pattern = '*',
     callback = function(args)
+      if not vim.api.nvim_buf_is_valid(args.buf) then return end
       local buf_name = vim.api.nvim_buf_get_name(args.buf)
       if buf_name:match('claude%-code') then
         vim.o.updatetime = claude_code.claude_code.saved_updatetime
