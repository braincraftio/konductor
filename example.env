# Konductor Environment Configuration
# CI runs on this file directly - this is operational, not documentation
# Local overrides: create .env (gitignored) or export in shell

# =============================================================================
# Container Registry
# =============================================================================
CONTAINER_REGISTRY=docker.io
CONTAINER_IMAGE=containercraft/konductor
CONTAINER_TAG=latest-qcow2

# =============================================================================
# Docker Hub Authentication
# Used when CONTAINER_REGISTRY=docker.io
# =============================================================================
DOCKER_USERNAME=containercraft
DOCKER_TOKEN=

# =============================================================================
# GitHub Authentication
# Used for: GHCR (CONTAINER_REGISTRY=ghcr.io), GitHub MCP, gh CLI
# Create token: https://github.com/settings/tokens (repo, read:org scopes)
# =============================================================================
GITHUB_ACTOR=
GITHUB_TOKEN=

# =============================================================================
# Gitea/Forgejo Authentication
# Used for: Gitea MCP server, tea/forgejo-cli
# Create token: Gitea Settings > Applications > Generate Token
# Set GITEA_TOKEN in .env (not here - this file is committed)
# =============================================================================
GITEA_URL=https://git.braincraft.io
GITEA_TOKEN=${GITEA_TOKEN:-}

# =============================================================================
# Claude Code User Preferences
# These are YOUR choices - set in .env to override defaults
# Project-level settings (timeouts, MCP limits) are in .claude/settings.json
# =============================================================================

# Privacy & Telemetry (1=opt-out, 0=opt-in)
# Consider your privacy preferences
DISABLE_TELEMETRY=0
DISABLE_ERROR_REPORTING=0

# Cost Warnings (1=hide, 0=show)
# Helpful to see costs while learning Claude Code usage patterns
DISABLE_COST_WARNINGS=0