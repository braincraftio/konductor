# Konductor Environment Configuration
# CI runs on this file directly - this is operational, not documentation
# Local overrides: create .env (gitignored) or export in shell

# =============================================================================
# Container Registry
# =============================================================================
CONTAINER_REGISTRY=docker.io
CONTAINER_IMAGE=containercraft/konductor
CONTAINER_TAG=latest-qcow2

# =============================================================================
# Docker Hub Authentication
# Used when CONTAINER_REGISTRY=docker.io
# =============================================================================
DOCKER_USERNAME=containercraft
DOCKER_TOKEN=

# =============================================================================
# GitHub Container Registry Authentication
# Used when CONTAINER_REGISTRY=ghcr.io
# =============================================================================
GITHUB_ACTOR=
GITHUB_TOKEN=

