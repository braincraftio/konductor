# Konductor direnv configuration
# Uses nix-direnv for flake integration with caching
#
# Stack: nix (devshell) + direnv (.envrc) + runme (tasks) + .env.example (defaults) + .env (overrides)
#
# Platform-specific devshell selection:
#   Linux:  .#full (all languages + IDE)
#   Darwin: .#full (all languages + IDE)

# Inherit environment from parent .envrc (WORKSPACE_ROOT, tokens, etc.)
# Set guard to skip parent's use flake (we use our own devshell)
_DIRENV_CHILD_SOURCING=1 source_up_if_exists
unset _DIRENV_CHILD_SOURCING

# Save WORKSPACE_ROOT before use flake (nix shell may clear environment)
_SAVED_WORKSPACE_ROOT="${WORKSPACE_ROOT:-}"

case "$(uname -s)" in
Linux*)  use flake .#konductor ;;
Darwin*) use flake .#full ;;
*)       use flake .#full ;;
esac

# Restore WORKSPACE_ROOT after use flake
export WORKSPACE_ROOT="${_SAVED_WORKSPACE_ROOT:-$(dirname "$PWD")}"
unset _SAVED_WORKSPACE_ROOT

# Add project bin wrappers to PATH
PATH_add .config/bin

dotenv .env.example
dotenv_if_exists .env
dotenv_if_exists ../.env

export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_TOKEN:-}"
