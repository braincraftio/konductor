# Konductor direnv configuration
# Uses nix-direnv for flake integration with caching
#
# Stack: nix (devshell) + direnv (.envrc) + runme (tasks) + .env.docker-dev.example (defaults) + .env (overrides)
#
# Platform-specific devshell selection:
#   Linux:  .#konductor (full + docker/qemu/libvirt)
#   Darwin: .#full (all languages + IDE)

# =============================================================================
# WORKSPACE_ROOT: Set BEFORE use_flake and preserve across it
# =============================================================================
# use_flake clears environment via _nix_direnv_hide_env (nix-direnv behavior)
# We must: 1) set WORKSPACE_ROOT, 2) add to preserved list, 3) then use_flake
PARENT_ENVRC="$(cd .. && find_up .envrc)"
export WORKSPACE_ROOT="$(dirname "$PARENT_ENVRC")"
_nix_direnv_preserved_env_vars+=( "WORKSPACE_ROOT" )

# Inherit environment from parent .envrc (skips parent's use_flake via guard)
_DIRENV_CHILD_SOURCING=1 source_up_if_exists
unset _DIRENV_CHILD_SOURCING

# Platform-specific devshell (WORKSPACE_ROOT survives because it's in preserved list)
# Skip flake loading if already inside Konductor environment (/.konductor exists)
if [[ -f /.konductor ]]; then
  # Parse provenance from TOML format
  _konductor_get() { grep "^$1 = " /.konductor | cut -d'"' -f2; }
  _git_commit=$(_konductor_get git_commit)
  _nix_drv=$(_konductor_get nix_drv)
  _build_date=$(_konductor_get build_date)
  _git_branch=$(_konductor_get git_branch)

  log_status "konductor: nix-${_nix_drv:0:7} git-${_git_commit:0:7} (${_git_branch}) built ${_build_date}"

  # Export provenance for build tooling
  export KONDUCTOR_PROVENANCE=/.konductor
  export KONDUCTOR_GIT_COMMIT="${_git_commit}"
  export KONDUCTOR_NIX_DRV="${_nix_drv}"

  unset _konductor_get _git_commit _nix_drv _build_date _git_branch
else
  case "$(uname -s)" in
  Linux*)  use flake .#konductor ;;
  Darwin*) use flake .#full ;;
  *)       use flake .#full ;;
  esac
fi

# Add project bin wrappers to PATH
PATH_add .config/bin

# Environment loading order (later files override earlier):
# 1. Parent defaults (workspace-wide config)
# 2. Parent overrides (user secrets, local config)
# 3. k9 defaults (QCOW2 build config, registry settings)
# 4. k9 overrides (user secrets, local config)
dotenv_if_exists ../.env.docker-dev.example
dotenv_if_exists ../.env
dotenv_if_exists .env.docker-dev.example
dotenv_if_exists .env

# Force KUBECONFIG after dotenv loading to ensure correct WORKSPACE_ROOT expansion
export KUBECONFIG="${WORKSPACE_ROOT}/.config/talos/clusters/docker-dev/generated/kubeconfig"

export GITHUB_PERSONAL_ACCESS_TOKEN="${GITHUB_TOKEN:-}"
