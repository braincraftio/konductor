# Standalone OCI Build Configuration
# For offline QCOW2 builds without parent workspace or cluster dependencies
# Copy to .env.oci and customize, or use directly (defaults work out-of-box)
#
# This file is loaded by .envrc after .env.docker-dev.example
# Values here override docker-dev defaults for standalone builds

# =============================================================================
# Container Registry (standalone target)
# =============================================================================
# Default: UCS internal registry for self-hosted builds
# Override: any OCI-compliant registry (docker.io, ghcr.io, etc.)
OCI_REGISTRY=registry.ucs.arpa
OCI_IMAGE=helix/flake
OCI_TAG=latest-qcow2

# Registry credentials (if required)
# OCI_REGISTRY_USERNAME=
# OCI_REGISTRY_PASSWORD=

# =============================================================================
# OCI Build Configuration
# =============================================================================
# Build file for runme tasks (relative to repo root)
OCI_BUILD_FILE=docs/developer_guide/qcow2/OCI.md

# Preflight check lists (same as QCOW2 defaults)
OCI_REQUIRED_BINS="nix qemu-img qemu-system-x86_64 genisoimage guestmount guestunmount virt-sparsify ssh rsync timeout ss du sha256sum jq docker skopeo"
OCI_REQUIRED_FILE_VARS="OVMF_CODE OVMF_VARS"
OCI_REQUIRED_VARS="OCI_BUILD_FILE"

# =============================================================================
# Resource Requirements
# =============================================================================
OCI_MIN_DISK_GB=100
OCI_MIN_MEM_MB=8192
OCI_MIN_CPUS=4

# =============================================================================
# Build Paths
# =============================================================================
# libguestfs backend (direct = no libvirt dependency)
LIBGUESTFS_BACKEND=direct

# Temporary paths (reuse QCOW2 paths for compatibility)
QCOW2_MOUNT=/tmp/nixmount
QCOW2_CLOUD_INIT_DIR=/tmp/konductor-build-cloud-init
QCOW2_PIDFILE=/tmp/konductor-build-vm.pid
QCOW2_SSH_KEY_DIR=${HOME}/.ssh
QCOW2_LOGFILE=build-vm.log

# =============================================================================
# VM Resources
# =============================================================================
QCOW2_VM_MEMORY=4096
QCOW2_VM_CPUS=4
QCOW2_SSH_PORT=2222
QCOW2_SSH_TIMEOUT=300

# =============================================================================
# Build Skip Flags (for development iteration)
# =============================================================================
# Set to true to skip phases when iterating on specific parts
SKIP_NIX_BUILD=false
SKIP_VM_PHASE=false
SKIP_COMPRESS=false

# =============================================================================
# Provenance Enforcement
# =============================================================================
# STRICT=true: Require /.konductor on build host (fail if missing)
# STRICT=false: Allow building on hosts without provenance (bootstrap mode)
KONDUCTOR_STRICT=false
