# Konductor project environment
# Works standalone or as a child repo inside a workspace.
# When inside a workspace, inherits WORKSPACE_ROOT, vault injection,
# and nix auth from the parent .envrc via source_up_if_exists.
# Setup: direnv allow

export DIRENV_LOG_FORMAT=""

# Inherit workspace environment if present (provides WORKSPACE_ROOT,
# Open Sesame vault injection, nix auth tokens, dotenv defaults).
# _DIRENV_CHILD_SOURCING prevents the parent from activating its own
# devshell; this repo activates its own flake below.
_DIRENV_CHILD_SOURCING=1 source_up_if_exists
unset _DIRENV_CHILD_SOURCING

# Project dotenv: defaults then local overrides
dotenv_if_exists .env.example
dotenv_if_exists .env

# Open Sesame vault injection (standalone, no-op if parent already injected)
if command -v sesame &>/dev/null && sesame status 2>/dev/null | grep -q "unlocked"; then
  eval "$(sesame export -p default 2>/dev/null)" || true
fi

# Activate project devshell
use flake

# Reload dotenv after use flake clears environment
dotenv_if_exists .env.example
dotenv_if_exists .env

# Re-inject vault secrets after use flake clears environment
if command -v sesame &>/dev/null && sesame status 2>/dev/null | grep -q "unlocked"; then
  eval "$(sesame export -p default 2>/dev/null)" || true
fi

# Nix GitHub authentication (prevents API rate limiting)
if [[ -n "${GITHUB_TOKEN:-}" ]]; then
  export NIX_CONFIG="access-tokens = github.com=${GITHUB_TOKEN}"
fi

PATH_add .config/bin
