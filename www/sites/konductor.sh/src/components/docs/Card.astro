---
interface Props {
  title?: string;
  icon?: string;
  className?: string;
}

const { title, icon, className = '' } = Astro.props;
---

<div class={`flex flex-col min-w-0 p-6 bg-surface-paper border border-border-default rounded-xl shadow-sm hover:shadow-md transition-shadow duration-300 not-prose overflow-hidden ${className}`}>
  {icon && <div class="text-3xl mb-4">{icon}</div>}
  {title && <h3 class="text-lg font-bold text-text-primary mb-2">{title}</h3>}
  <div class="flex-1 flex flex-col min-w-0 text-text-secondary leading-relaxed [&>.expressive-code]:mt-auto">
    <slot />
  </div>
</div>
