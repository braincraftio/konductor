---
interface Props {
  title?: string;
  subtitle?: string;
  tone?: 'warm' | 'cool' | 'mint';
  divider?: boolean;
  className?: string;
}

const { title, subtitle, tone, divider = false, className = '' } = Astro.props;

const toneClass = tone ? `tone-${tone}` : '';
---

<section class:list={['space-y-6', toneClass, className]}>
  {divider && <div class="border-t border-border-subtle" />}
  {title && (
    <div>
      <h2
        class:list={['text-2xl md:text-3xl font-bold', !tone && 'text-text-secondary']}
        style={tone ? 'color: var(--section-accent)' : undefined}
      >
        {title}
      </h2>
      {subtitle && (
        <p class="text-text-tertiary text-sm mt-1 italic">{subtitle}</p>
      )}
    </div>
  )}
  <slot />
</section>
