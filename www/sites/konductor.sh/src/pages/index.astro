---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar';
import Typewriter from '../components/Typewriter';
import { Image } from 'astro:assets';
import konductorImage from '../../public/images/konductor.png';
---

<Layout>
    <Navbar client:load />
    
	<main class="min-h-screen flex flex-col items-center justify-center p-4 md:p-8 pt-24 md:pt-32">
		<div class="max-w-5xl w-full space-y-16 md:space-y-24">
            <!-- Hero Section -->
            <section class="flex flex-col items-center justify-center space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700 max-w-full overflow-x-hidden pb-8">
                
                <!-- Title with stabilized layout -->
                <h1 class="w-full grid grid-cols-2 text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-text-primary leading-[1.1]">
                    <div class="text-right whitespace-nowrap pr-[0.4em]">Orchestrate</div>
                    <div class="text-left min-w-0 relative whitespace-nowrap pl-[0.4em]" style="-webkit-mask-image: linear-gradient(to right, black 80%, transparent 100%); mask-image: linear-gradient(to right, black 80%, transparent 100%);">
                        <Typewriter 
                            client:load 
                            words={[
                                "Neovim",
                                "DevShells",
                                "Pipelines",
                                "Containers",
                                "Virtual Machines",
                                "Infrastructure",
                                "Kubernetes",
                                "Cloud",
                                "Agents",
                                "Copilot",
                                "Claude",
                                "OpenCode",
                                "Codex",
                                "Linters",
                                "Formatters",
                                "Analysis",
                                "Debugging",
                                "Engineering"
                            ]} 
                        />
                    </div>
                </h1>
                
                <!-- Divider -->
                <div class="w-11/12 md:w-3/4 max-w-4xl h-px bg-gradient-to-r from-transparent via-text-tertiary/40 to-transparent shadow-[0_1px_2px_rgba(0,0,0,0.1)]"></div>

                <!-- Tagline -->
                <p class="text-xs sm:text-sm md:text-lg text-text-tertiary font-mono font-light text-center w-full whitespace-nowrap overflow-hidden tracking-wide px-4">
                    Hermetic Tooling <span class="mx-1 md:mx-3 text-brand-primary/60">•</span> Polyglot Environments <span class="mx-1 md:mx-3 text-brand-primary/60">•</span> Sovereign Software Development
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-4">
                    <a href="/manual" class="btn btn-primary w-full sm:w-auto group relative overflow-hidden px-8 py-3 border border-white/20 shadow-lg shadow-lavender/20 hover:shadow-xl hover:shadow-lavender/30 hover:-translate-y-0.5 transition-all duration-300">
                        <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
                        <span class="relative z-10 font-semibold text-white tracking-wide">Get Started</span>
                        <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1 relative z-10 text-white" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </a>
                    <a href="https://github.com/braincraftio/konductor/releases" target="_blank" rel="noopener noreferrer" class="btn btn-secondary w-full sm:w-auto px-6 py-3 border border-zinc-200 dark:border-zinc-700 hover:border-zinc-300 dark:hover:border-zinc-600 bg-surface-paper shadow-lg shadow-zinc-200/50 dark:shadow-black/30 hover:shadow-xl hover:shadow-zinc-200/70 dark:hover:shadow-black/50 hover:-translate-y-0.5 transition-all duration-300 group">
                        <svg class="w-5 h-5 mr-2 text-zinc-700 dark:text-zinc-200 group-hover:text-black dark:group-hover:text-white transition-colors" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                            <path fill-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" clip-rule="evenodd"></path>
                        </svg>
                        <span class="font-mono text-sm opacity-90 font-medium">v1.0.0-beta</span>
                    </a>
                </div>
            </section>

            <!-- Terminal Visualization -->
            <div class="relative w-full group perspective-1000">
                <!-- Ambient Glow -->
                <div class="absolute -inset-1.5 bg-gradient-to-r from-purple-600/30 via-fuchsia-600/30 to-indigo-600/30 rounded-2xl blur-2xl opacity-40 group-hover:opacity-60 transition duration-1000 group-hover:duration-500 dark:from-lavender-300/15 dark:via-fuchsia-300/15 dark:to-mint-300/15"></div>
                
                <!-- Main Container -->
                <div class="relative w-full rounded-xl bg-surface-raised shadow-2xl shadow-black/50 overflow-hidden border border-border-default transform transition-all duration-500 group-hover:scale-[1.005] group-hover:-translate-y-1 flex flex-col">
                    <div class="h-8 bg-[#3f3f46] flex items-center px-3 gap-2 border-b border-[#52525b] shrink-0 dark:bg-[#27272a] dark:border-[#3f3f46] relative z-10 shadow-md">
                        <div class="w-2.5 h-2.5 rounded-full bg-[#FF5F56] hover:bg-[#FF5F56]/80 transition-colors shadow-inner"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#FFBD2E] hover:bg-[#FFBD2E]/80 transition-colors shadow-inner"></div>
                        <div class="w-2.5 h-2.5 rounded-full bg-[#27C93F] hover:bg-[#27C93F]/80 transition-colors shadow-inner"></div>
                        <div class="ml-2 font-mono text-[10px] text-zinc-300 flex-1 text-center pr-8 opacity-70">konductor — dev — 192x48</div>
                    </div>
                    
                    <div class="relative w-full aspect-[16/9] bg-[#27272a]">
                    <Image 
                        src={konductorImage}
                    alt="Konductor Development Environment" 
                    class="w-full h-full object-cover"
                    loading="eager"
                   />
                </div>
            </div>

            <!-- Value Props Grid -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8">
                <div class="group p-8 rounded-3xl bg-surface-paper border border-border-subtle shadow-sm hover:shadow-xl hover:shadow-lavender/10 hover:border-brand-primary/20 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-brand-primary/10 flex items-center justify-center mb-6 text-brand-primary group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold mb-3 text-text-primary">Hermetic by Default</h3>
                        <p class="text-text-secondary leading-relaxed font-light">
                            Zero global dependencies. Every tool, library, and runtime is pinned to a specific hash.
                        </p>
                    </div>
                </div>
                <div class="group p-8 rounded-3xl bg-surface-paper border border-border-subtle shadow-sm hover:shadow-xl hover:shadow-mint/10 hover:border-brand-secondary/20 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                     <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-brand-secondary/10 flex items-center justify-center mb-6 text-brand-secondary group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold mb-3 text-text-primary">Multi-Target</h3>
                        <p class="text-text-secondary leading-relaxed font-light">
                            DevShells, OCI Containers, and QCOW2 VMs generated from a Single Source of Truth.
                        </p>
                    </div>
                </div>
                <div class="group p-8 rounded-3xl bg-surface-paper border border-border-subtle shadow-sm hover:shadow-peach/10 hover:border-brand-accent/20 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                     <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-brand-accent/10 flex items-center justify-center mb-6 text-brand-accent group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-bold mb-3 text-text-primary">Sovereign Cloud</h3>
                        <p class="text-text-secondary leading-relaxed font-light">
                            The entry point to the BrainCraft ecosystem. Own your stack from the metal up.
                        </p>
                    </div>
                </div>
            </div>
		</div>
	</main>
</Layout>
