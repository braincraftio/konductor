---
import Layout from '../layouts/Layout.astro';
import Navbar from '../components/Navbar.astro';
import TypeWriter from '../components/TypeWriter.astro';
import { Image } from 'astro:assets';
import konductorImage from '../../public/images/konductor.png';
import { href } from '../utils/paths';
---

<Layout title="Konductor.sh | Hermetic Dev Environments" description="Reproducible dev environments from one Nix flake. DevShells, containers, and VMs.">
    <Navbar />

    <main data-pagefind-body class="min-h-screen flex flex-col items-center justify-center p-4 md:p-8 pt-24 md:pt-32">
        <div class="max-w-5xl w-full space-y-16 md:space-y-24">
            <!-- Hero -->
            <section class="text-center space-y-8 animate-in fade-in slide-in-from-bottom-4 duration-700">
                <h1 class="text-5xl md:text-7xl lg:text-8xl font-bold tracking-tight text-text-primary leading-[1.1]">
                    Orchestrate
                    <TypeWriter />
                </h1>

                <p class="text-xl md:text-2xl text-text-secondary max-w-3xl mx-auto leading-relaxed font-light">
                    Reproducible dev environments. DevShells, containers, and VMs from one Nix flake.
                </p>

                <div class="flex flex-col sm:flex-row items-center justify-center gap-4 pt-8">
                    <a href={href('/manual')} class="btn btn-primary w-full sm:w-auto group relative overflow-hidden">
                        <div class="absolute inset-0 w-full h-full bg-gradient-to-r from-transparent via-white/20 to-transparent -translate-x-full group-hover:animate-shimmer"></div>
                        Get Started
                        <svg class="w-4 h-4 ml-2 transition-transform group-hover:translate-x-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 7l5 5m0 0l-5 5m5-5H6" />
                        </svg>
                    </a>
                    <a href="https://github.com/braincraftio/konductor" class="btn btn-secondary w-full sm:w-auto">
                        View Source
                    </a>
                </div>
            </section>

            <!-- Terminal -->
            <div class="relative w-full aspect-[16/9] rounded-xl bg-surface-raised shadow-2xl shadow-lavender/20 overflow-hidden border border-border-default group transform transition-transform hover:scale-[1.01] duration-500">
                <div class="absolute top-0 left-0 right-0 h-6 bg-surface-subtle flex items-center px-3 gap-1.5 border-b border-border-default z-20">
                    <div class="w-2 h-2 rounded-full bg-[#FF5F56] shadow-inner"></div>
                    <div class="w-2 h-2 rounded-full bg-[#FFBD2E] shadow-inner"></div>
                    <div class="w-2 h-2 rounded-full bg-[#27C93F] shadow-inner"></div>
                    <div class="ml-2 font-mono text-[10px] text-text-tertiary flex-1 text-center pr-8 opacity-50">konductor — dev</div>
                </div>
                <div class="absolute inset-0 top-6">
                    <Image
                        src={konductorImage}
                        alt="Konductor Development Environment"
                        class="w-full h-full object-cover object-top"
                        loading="eager"
                    />
                </div>
            </div>

            <!-- Value Props -->
            <div class="grid grid-cols-1 md:grid-cols-3 gap-8 pt-8">
                <div class="group p-8 rounded-3xl bg-surface-paper border border-border-subtle shadow-sm hover:shadow-xl hover:shadow-lavender/10 hover:border-brand-primary/20 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-primary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-brand-primary/10 flex items-center justify-center mb-6 text-brand-primary group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold mb-3 text-text-secondary">Hermetic by Default</h3>
                        <p class="text-text-secondary leading-relaxed font-light">
                            Zero global dependencies. Every tool, library, and runtime is pinned to a specific hash.
                        </p>
                    </div>
                </div>
                <div class="group p-8 rounded-3xl bg-surface-paper border border-border-subtle shadow-sm hover:shadow-xl hover:shadow-mint/10 hover:border-brand-secondary/20 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-secondary/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-brand-secondary/10 flex items-center justify-center mb-6 text-brand-secondary group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 7v10c0 2.21 3.582 4 8 4s8-1.79 8-4V7M4 7c0 2.21 3.582 4 8 4s8-1.79 8-4M4 7c0-2.21 3.582-4 8-4s8 1.79 8 4m0 5c0 2.21-3.582 4-8 4s-8-1.79-8-4" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold mb-3 text-text-secondary">Multi-Target</h3>
                        <p class="text-text-secondary leading-relaxed font-light">
                            DevShells, OCI Containers, and QCOW2 VMs generated from a Single Source of Truth.
                        </p>
                    </div>
                </div>
                <div class="group p-8 rounded-3xl bg-surface-paper border border-border-subtle shadow-sm hover:shadow-peach/10 hover:border-brand-accent/20 transition-all duration-300 relative overflow-hidden">
                    <div class="absolute inset-0 bg-gradient-to-br from-brand-accent/5 to-transparent opacity-0 group-hover:opacity-100 transition-opacity duration-300"></div>
                    <div class="relative z-10">
                        <div class="w-14 h-14 rounded-2xl bg-brand-accent/10 flex items-center justify-center mb-6 text-brand-accent group-hover:scale-110 transition-transform duration-300">
                            <svg class="w-7 h-7" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M12 11c0 3.517-1.009 6.799-2.753 9.571m-3.44-2.04l.054-.09A13.916 13.916 0 008 11a4 4 0 118 0c0 1.017-.07 2.019-.203 3m-2.118 6.844A21.88 21.88 0 0015.171 17m3.839 1.132c.645-2.266.99-4.659.99-7.132A8 8 0 008 4.07M3 15.364c.64-1.319 1-2.8 1-4.364 0-1.457.39-2.823 1.07-4" />
                            </svg>
                        </div>
                        <h3 class="text-xl font-semibold mb-3 text-text-secondary">Sovereign Cloud</h3>
                        <p class="text-text-secondary leading-relaxed font-light">
                            The entry point to the BrainCraft ecosystem. Own your stack from the metal up.
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </main>
</Layout>
